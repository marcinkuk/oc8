# oc8 environment defaults for the Portainer git stack (192.168.1.134).
# Non-secret defaults only. Real secrets are injected as Portainer stack env
# pairs (they override this file because Portainer passes them via --env-file).
# Set OC8_DOMAIN to the public hostname once DNS points at this server;
# empty keeps Caddy on plain HTTP :80.
OC8_DOMAIN=
OC8_ENV=prod
OC8_DEMO=false
OC8_SEED_ON_START=false
OC8_HTTP_PORT=80
OC8_HTTPS_PORT=443
OC8_WORKERS=2
OC8_AGENT_ISOLATION=true
OC8_RUNTIME_SESSION_ROOT=/var/lib/oc8/sessions
OC8_CONTAINER_SOCKET=/var/run/docker.sock
OC8_S3_ENDPOINT=http://minio:9000
OC8_S3_ACCESS_KEY=oc8-minio
OC8_S3_BUCKET=oc8-uploads
OC8_S3_REGION=us-east-1
OTEL_SDK_DISABLED=true
# Local reasoning model on a single inference slot: one step can take minutes,
# so every per-call allowance is 10x the oc8 default. Values, not code.
OC8_DEFAULT_MAX_TOKENS=16384
OC8_LLM_REQUEST_TIMEOUT_S=1800
OC8_AGENT_STEP_REQUEST_TIMEOUT_S=3000
OC8_LOCAL_TOOL_TIMEOUT_S=1200
OC8_RUN_PROGRAM_TIMEOUT_S=1200
OC8_RUN_PROGRAM_MAX_TIMEOUT_S=6000
OC8_MCP_REQUEST_TIMEOUT_S=1800
